{
  "name": "aot_alcohol_serving_permit_application_farm_sales",
  "version": "0.1",
  "value": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Gårdsförsäljning",
    "type": "object",
    "properties": {
      "arDuFirmatecknare": {
        "type": "string",
        "oneOf": [
          {
            "const": "JA",
            "title": "Ja"
          },
          {
            "const": "NEJ",
            "title": "Nej"
          }
        ],
        "title": "Är du firmatecknare?"
      },
      "foretagsform": {
        "type": "string",
        "oneOf": [
          {
            "const": "AKTIEBOLAG",
            "title": "Aktiebolag"
          },
          {
            "const": "ENSKILD_FIRMA_REGISTRERAD_HOS_SKATTEVERKET",
            "title": "Enskild firma (registrerad hos Skatteverket och Bolagsverket)"
          },
          {
            "const": "ENSKILD_FIRMA_REGISTRERAD_ENDAST_HOS",
            "title": "Enskild firma (registrerad endast hos Skatteverket)"
          },
          {
            "const": "FORENING_STIFTELSE",
            "title": "Förening/stiftelse"
          },
          {
            "const": "HANDELSBOLAG",
            "title": "Handelsbolag"
          },
          {
            "const": "KOMMANDITBOLAG",
            "title": "Kommanditbolag"
          }
        ],
        "title": "Företagsform"
      },
      "fakturaadressSammaSomForetaget": {
        "type": "string",
        "oneOf": [
          {
            "const": "JA",
            "title": "Ja"
          },
          {
            "const": "NEJ",
            "title": "Nej"
          }
        ],
        "title": "Är fakturaadressen samma som företagets adress?",
        "description": "Kommunen kan komma att ta ut en avgift. Om du vill att fakturan ska gå till den adress som företaget är registrerad på anger du \"Ja\" i fältet nedan. Om du vill att fakturan ska gå till en annan adress anger du \"Nej\" och fyller sedan i den. Du har även möjlighet att ange en fakturareferens."
      },
      "fakturamottagare": {
        "type": "object",
        "properties": {
          "cO": {
            "type": "string",
            "title": "c/o"
          },
          "utdelningsadress": {
            "type": "string",
            "title": "Utdelningsadress"
          },
          "postnummer": {
            "type": "string",
            "title": "Postnummer",
            "pattern": "^\\d{3}\\s?\\d{2}$"
          },
          "postort": {
            "type": "string",
            "title": "Postort"
          }
        },
        "required": [
          "utdelningsadress",
          "postnummer",
          "postort"
        ],
        "title": "Fakturamottagare"
      },
      "fakturareferens": {
        "type": "string",
        "title": "Fakturareferens",
        "description": "Ange här om du vill att fakturan ska ha någon specifik märkning, exempelvis ett namn eller nummer."
      },
      "verksamhetsbeskrivningsval": {
        "type": "string",
        "oneOf": [
          {
            "const": "JAG_VILL_SKRIVA_VERKSAMHETSBESKRIVNINGEN_I",
            "title": "Jag vill skriva verksamhetsbeskrivningen i formuläret"
          },
          {
            "const": "JAG_VILL_BIFOGA_VERKSAMHETSBESKRIVNINGEN_SOM",
            "title": "Jag vill bifoga verksamhetsbeskrivningen som fil"
          }
        ],
        "title": "Verksamhetsbeskrivning",
        "description": "Du måste lämna en detaljerad beskrivning av företagets verksamhet.\n\nHur vill du lämna verksamhetsbeskrivningen?"
      },
      "verksamhetsbeskrivning": {
        "type": "string",
        "title": "Verksamhetsbeskrivning"
      },
      "forsaljningsstalle": {
        "type": "object",
        "properties": {
          "forsaljningsstalletsNamn": {
            "type": "string",
            "title": "Försäljningsställets namn"
          },
          "gatuadress": {
            "type": "string",
            "title": "Gatuadress"
          },
          "postnummer": {
            "type": "string",
            "title": "Postnummer"
          },
          "postort": {
            "type": "string",
            "title": "Postort"
          },
          "telefonnummer": {
            "type": "string",
            "title": "Telefonnummer"
          },
          "ePostadress": {
            "type": "string",
            "title": "E-postadress"
          }
        },
        "title": "Försäljningsställe"
      },
      "alkoholdrycker": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "oneOf": [
            {
              "const": "STARKOL",
              "title": "Starköl"
            },
            {
              "const": "VIN",
              "title": "Vin"
            },
            {
              "const": "SPRITDRYCKER",
              "title": "Spritdrycker"
            },
            {
              "const": "CIDER_ELLER_ANDRA_JASTA_ALKOHOLDRYCKER",
              "title": "Cider eller andra jästa alkoholdrycker"
            }
          ]
        },
        "title": "Alkoholdrycker"
      },
      "forsaljningsperiod": {
        "type": "string",
        "oneOf": [
          {
            "const": "ARET_RUNT",
            "title": "Året runt"
          },
          {
            "const": "ARLIGEN_UNDER_VISS_PERIOD",
            "title": "Årligen under viss period"
          }
        ],
        "title": "Försäljningsperiod"
      },
      "angePeriodForForsaljning": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date",
            "title": "Från och med"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "title": "Till och med"
          }
        },
        "required": [
          "startDate",
          "endDate"
        ],
        "title": "Ange period för försäljning"
      },
      "forsaljningstider": {
        "type": "object",
        "properties": {
          "startTime": {
            "type": "string",
            "format": "time",
            "title": "Från klockan"
          },
          "endTime": {
            "type": "string",
            "format": "time",
            "title": "Till klockan"
          }
        },
        "required": [
          "startTime",
          "endTime"
        ],
        "title": "Försäljningstider"
      },
      "besoksarrangemang": {
        "type": "string",
        "oneOf": [
          {
            "const": "JAG_VILL_LADDA_UPP_BESKRIVNING",
            "title": "Jag vill ladda upp beskrivning på besöksarrangemanget"
          },
          {
            "const": "JAG_VILL_BESKRIVA_BESOKSARRANGEMANGET",
            "title": "Jag vill beskriva besöksarrangemanget"
          }
        ],
        "title": "Besöksarrangemang"
      },
      "beskrivBesoksarrangemanget": {
        "type": "string",
        "title": "Beskriv besöksarrangemanget"
      },
      "beskrivForsaljningsplats": {
        "type": "string",
        "title": "Beskriv försäljningsplats"
      },
      "harDuKassaregister": {
        "type": "string",
        "oneOf": [
          {
            "const": "JA",
            "title": "Ja"
          },
          {
            "const": "NEJ",
            "title": "Nej"
          }
        ],
        "title": "Har du kassaregister?"
      },
      "angeRegistreringskod": {
        "type": "object",
        "properties": {
          "registreringskod": {
            "type": "string",
            "title": "Registreringskod"
          }
        },
        "title": "Ange registreringskod"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "foretagsform": {
              "enum": [
                "AKTIEBOLAG",
                "ENSKILD_FIRMA_REGISTRERAD_HOS_SKATTEVERKET",
                "ENSKILD_FIRMA_REGISTRERAD_ENDAST_HOS",
                "FORENING_STIFTELSE",
                "HANDELSBOLAG",
                "KOMMANDITBOLAG"
              ]
            }
          },
          "required": [
            "foretagsform"
          ]
        },
        "then": {
          "required": [
            "verksamhetsbeskrivningsval"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "fakturaadressSammaSomForetaget": {
              "const": "NEJ"
            }
          },
          "required": [
            "fakturaadressSammaSomForetaget"
          ]
        },
        "then": {
          "properties": {
            "fakturamottagare": true
          }
        }
      },
      {
        "if": {
          "properties": {
            "verksamhetsbeskrivningsval": {
              "const": "JAG_VILL_SKRIVA_VERKSAMHETSBESKRIVNINGEN_I"
            }
          },
          "required": [
            "verksamhetsbeskrivningsval"
          ]
        },
        "then": {
          "properties": {
            "verksamhetsbeskrivning": true
          }
        }
      },
      {
        "if": {
          "properties": {
            "forsaljningsperiod": {
              "const": "ARLIGEN_UNDER_VISS_PERIOD"
            }
          },
          "required": [
            "forsaljningsperiod"
          ]
        },
        "then": {
          "properties": {
            "angePeriodForForsaljning": true
          }
        }
      },
      {
        "if": {
          "properties": {
            "besoksarrangemang": {
              "const": "JAG_VILL_BESKRIVA_BESOKSARRANGEMANGET"
            }
          },
          "required": [
            "besoksarrangemang"
          ]
        },
        "then": {
          "required": [
            "beskrivBesoksarrangemanget"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "harDuKassaregister": {
              "const": "JA"
            }
          },
          "required": [
            "harDuKassaregister"
          ]
        },
        "then": {
          "properties": {
            "angeRegistreringskod": true
          }
        }
      }
    ],
    "x-attachments": [
      {
        "key": "laddaUppFullmakt",
        "label": "Fullmakt",
        "requiredWhen": {
          "properties": {
            "arDuFirmatecknare": {
              "const": "NEJ"
            }
          },
          "required": [
            "arDuFirmatecknare"
          ]
        }
      },
      {
        "key": "bifogaAktuelltRegistreringsbevisFran",
        "label": "Registreringsbevis från Bolagsverket",
        "description": "Har du inte något registreringsbevis tillgängligt så kan du hämta ett på verksamt.se.",
        "requiredWhen": {
          "properties": {
            "foretagsform": {
              "enum": [
                "AKTIEBOLAG",
                "ENSKILD_FIRMA_REGISTRERAD_HOS_SKATTEVERKET",
                "FORENING_STIFTELSE",
                "HANDELSBOLAG",
                "KOMMANDITBOLAG"
              ]
            }
          },
          "required": [
            "foretagsform"
          ]
        }
      },
      {
        "key": "bifogaUppgifterOmAgarforhallanden",
        "label": "Uppgifter om ägarförhållanden",
        "description": "Handlingar som styrker vilka fysiska personer som finns bakom organisationsnumret. Aktiebolag: dokumentation som visar aktiefördelningen, exempelvis en aktiebok. Handelsbolag och kommanditbolag: dokumentation som visar ägarfördelningen, exempelvis ett bolagsavtal. Förening eller stiftelse: stadgar eller protokoll från konstituerande möte som visar vilka som är firmatecknare. Koncern: information om ägarförhållanden för koncernbolaget utöver handlingen för bolagsformen.",
        "requiredWhen": {
          "properties": {
            "foretagsform": {
              "enum": [
                "AKTIEBOLAG",
                "FORENING_STIFTELSE",
                "HANDELSBOLAG",
                "KOMMANDITBOLAG"
              ]
            }
          },
          "required": [
            "foretagsform"
          ]
        }
      },
      {
        "key": "bifogaRegisterutdragFranSkatteverket",
        "label": "Registerutdrag från Skatteverket",
        "description": "Av registerutdraget framgår om du eller ditt företag är godkänt för F-skatt eller FA-skatt, är momsregistrerat och registrerat som arbetsgivare. Du hämtar ett registerutdrag på verksamt.se.",
        "requiredWhen": {
          "properties": {
            "foretagsform": {
              "enum": [
                "AKTIEBOLAG",
                "ENSKILD_FIRMA_REGISTRERAD_HOS_SKATTEVERKET",
                "ENSKILD_FIRMA_REGISTRERAD_ENDAST_HOS",
                "FORENING_STIFTELSE",
                "HANDELSBOLAG",
                "KOMMANDITBOLAG"
              ]
            }
          },
          "required": [
            "foretagsform"
          ]
        }
      },
      {
        "key": "bifogaVerksamhetsbeskrivning",
        "label": "Verksamhetsbeskrivning"
      },
      {
        "key": "bifogadBeskrivningBesoksarrangemang",
        "label": "Beskrivning av besöksarrangemanget",
        "requiredWhen": {
          "properties": {
            "besoksarrangemang": {
              "const": "JAG_VILL_LADDA_UPP_BESKRIVNING"
            }
          },
          "required": [
            "besoksarrangemang"
          ]
        }
      },
      {
        "key": "laddaUppEgenkontrollprogram",
        "label": "Egenkontrollprogram"
      },
      {
        "key": "ritningForForsaljningslokal",
        "label": "Ritning för försäljningslokal"
      },
      {
        "key": "hyresavtalEllerAgarbevis",
        "label": "Hyresavtal eller ägarbevis"
      },
      {
        "key": "gardsforsaljningstillstand",
        "label": "Gårdsförsäljningstillstånd"
      }
    ]
  },
  "description": "Gårdsförsäljning"
}
