          },
          {
            "const": "TIDSBEGRANSAD_FORSALJNING",
            "title": "Tidsbegränsad försäljning"
          }
        ],
        "title": "Tidsperiod för försäljningen"
      },
      "startdatumForsaljning": {
        "type": "string",
        "format": "date",
        "title": "Startdatum försäljning"
      },
      "periodTidsbegransadForsaljning": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date",
            "title": "Från och med"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "title": "Till och med"
          }
