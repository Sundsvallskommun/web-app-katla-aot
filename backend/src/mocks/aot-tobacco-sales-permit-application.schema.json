      },
      "besoksadress": {
        "type": "object",
        "properties": {
          "gatuadress": {
            "type": "string",
            "title": "Gatuadress"
          },
          "postnummer": {
            "type": "string",
            "title": "Postnummer"
          },
          "postort": {
            "type": "string",
            "title": "Postort"
          },
