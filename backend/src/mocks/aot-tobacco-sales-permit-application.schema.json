            "type": "string",
            "title": "Utdelningsadress"
          },
          "postnummer": {
            "type": "string",
            "title": "Postnummer",
            "pattern": "^\\d{3}\\s?\\d{2}$"
          },
          "postort": {
            "type": "string",
            "title": "Postort"
          }
        },
