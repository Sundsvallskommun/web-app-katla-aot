{
  "name": "aot_alcohol_folkol_serving_notification",
  "version": "0.1",
  "value": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Servering av folköl (klass 2)",
    "type": "object",
    "properties": {
      "arDuFirmatecknare": {
        "type": "string",
        "oneOf": [
          {
            "const": "JA",
            "title": "Ja"
          },
          {
            "const": "NEJ",
            "title": "Nej"
          }
        ],
        "title": "Är du firmatecknare?"
      },
      "foretagsform": {
        "type": "string",
        "oneOf": [
          {
            "const": "AKTIEBOLAG",
            "title": "Aktiebolag"
          },
          {
            "const": "ENSKILD_FIRMA_REGISTRERAD_HOS_SKATTEVERKET",
            "title": "Enskild firma (registrerad hos Skatteverket och Bolagsverket)"
          },
          {
            "const": "ENSKILD_FIRMA_REGISTRERAD_ENDAST_HOS",
            "title": "Enskild firma (registrerad endast hos Skatteverket)"
          },
          {
            "const": "FORENING_STIFTELSE",
            "title": "Förening/stiftelse"
          },
          {
            "const": "HANDELSBOLAG",
            "title": "Handelsbolag"
          },
          {
            "const": "KOMMANDITBOLAG",
            "title": "Kommanditbolag"
          }
        ],
        "title": "Företagsform"
      },
      "fakturaadressSammaSomForetaget": {
        "type": "string",
        "oneOf": [
          {
            "const": "JA",
            "title": "Ja"
          },
          {
            "const": "NEJ",
            "title": "Nej"
          }
        ],
        "title": "Är fakturaadressen samma som företagets adress?",
        "description": "Kommunen kan komma att ta ut en avgift. Om du vill att fakturan ska gå till den adress som företaget är registrerad på anger du \"Ja\" i fältet nedan. Om du vill att fakturan ska gå till en annan adress anger du \"Nej\" och fyller sedan i den. Du har även möjlighet att ange en fakturareferens."
      },
      "fakturamottagare": {
        "type": "object",
        "properties": {
          "cO": {
            "type": "string",
            "title": "c/o"
          },
          "utdelningsadress": {
            "type": "string",
            "title": "Utdelningsadress"
          },
          "postnummer": {
            "type": "string",
            "title": "Postnummer",
            "pattern": "^\\d{3}\\s?\\d{2}$"
          },
          "postort": {
            "type": "string",
            "title": "Postort"
          }
        },
        "required": [
          "utdelningsadress",
          "postnummer",
          "postort"
        ],
        "title": "Fakturamottagare"
      },
      "fakturareferens": {
        "type": "string",
        "title": "Fakturareferens",
        "description": "Ange här om du vill att fakturan ska ha någon specifik märkning, exempelvis ett namn eller nummer."
      },
      "verksamhetsbeskrivningsval": {
        "type": "string",
        "oneOf": [
          {
            "const": "JAG_VILL_SKRIVA_VERKSAMHETSBESKRIVNINGEN_I",
            "title": "Jag vill skriva verksamhetsbeskrivningen i formuläret"
          },
          {
            "const": "JAG_VILL_BIFOGA_VERKSAMHETSBESKRIVNINGEN_SOM",
            "title": "Jag vill bifoga verksamhetsbeskrivningen som fil"
          }
        ],
        "title": "Verksamhetsbeskrivning",
        "description": "Du måste lämna en detaljerad beskrivning av företagets verksamhet.\n\nHur vill du lämna verksamhetsbeskrivningen?"
      },
      "verksamhetsbeskrivning": {
        "type": "string",
        "title": "Verksamhetsbeskrivning"
      },
      "kommerNiAttServeraMat": {
        "type": "string",
        "oneOf": [
          {
            "const": "JA",
            "title": "Ja"
          },
          {
            "const": "NEJ",
            "title": "Nej"
          }
        ],
        "title": "Kommer ni att servera mat"
      },
      "beskrivUtbudetAvMat": {
        "type": "string",
        "oneOf": [
          {
            "const": "JAG_VILL_BIFOGA_MENY_SOM",
            "title": "Jag vill bifoga meny som bilaga"
          },
          {
            "const": "JAG_VILL_SKRIVA_IN_MENYN",
            "title": "Jag vill skriva in menyn i formuläret"
          }
        ],
        "title": "Beskriv utbudet av mat",
        "description": "\"En förutsättning för att få servera alkoholdrycker är att det även serveras mat. Utbudet av mat ska vara tillrett, tillräckligt och tillgängligt. Detta innebär att du ska ha mat som du har kapacitet att tillreda på plats i restaurangen och matutbudet ska även alltid vara tillgängligt för gästerna i verksamheten. Du kan välja att bifoga en meny om du har en sådan. Annars kan du välja att skriva in denna i formuläret. Om du har en annan, enklare meny efter kl. 23 ska du även bifoga den eller skriva in denna i formuläret nedan. Exempel på rätter i en enklare meny är hamburgare, sallad, paj, varma smörgåsar och bakad potatis.\" detta stod tidigare i beskrivning"
      },
      "meny": {
        "type": "string",
        "title": "Meny"
      },
      "egenkontrollprogramFolkol": {
        "type": "string",
        "oneOf": [
          {
            "const": "JA",
            "title": "Ja"
          },
          {
            "const": "NEJ_JAG_FYLLER_I_DOKUMENTET",
            "title": "Nej, jag fyller i dokumentet och kan visa upp det vid tillsyn"
          }
        ],
        "title": "Egenkontrollprogram vid servering av folköl (klass 2)",
        "description": "Din verksamhet behöver ha ett så kallat \"egenkontrollprogram\".\n\nEtt egenkontrollprogram fungerar som ett stöd för dig som näringsidkare i egenkontrollen och är ett viktigt underlag för kommunen när det blir tillsyn.\n\nOm du och din verksamhet inte följer alkohollagens bestämmelser kan kommunen ge dig serveringsförbud eller en varning. Det gäller också om din verksamhet inte har ett egenkontrollprogram.\n\n${serveringfolkolegenkontrollprogram}\n\nVill du bifoga ifyllt egenkontrollprogram i denna anmälan?"
      },
      "serveringsstalletsNamn": {
        "type": "object",
        "properties": {
          "namn": {
            "type": "string",
            "title": "Namn"
          }
        },
        "title": "Serveringsställets namn",
        "description": "Det namn som du skyltar med till kund."
      },
      "besoksadressSammaSomForetaget": {
        "type": "string",
        "oneOf": [
          {
            "const": "JA",
            "title": "Ja"
          },
          {
            "const": "NEJ",
            "title": "Nej"
          }
        ],
        "title": "Är serveringsställets besöksadress samma som företagets adress?"
      },
      "serveringsstalletsBesoksadress": {
        "type": "object",
        "properties": {
          "gatuadress": {
            "type": "string",
            "title": "Gatuadress"
          },
          "postnummer": {
            "type": "string",
            "title": "Postnummer"
          },
          "postort": {
            "type": "string",
            "title": "Postort"
          }
        },
        "title": "Serveringsställets besöksadress"
      },
      "kontaktuppgifterTillServeringsstallet": {
        "type": "object",
        "properties": {
          "telefonnummer": {
            "type": "string",
            "title": "Telefonnummer"
          },
          "ePostadress": {
            "type": "string",
            "title": "E-postadress"
          },
          "hemsida": {
            "type": "string",
            "title": "Hemsida"
          },
          "telefon": {
            "type": "string",
            "title": "Telefon"
          }
        },
        "title": "Kontaktuppgifter till serveringsstället"
      },
      "sittplatserILokalen": {
        "type": "object",
        "properties": {
          "antalSittplatserInomhus": {
            "type": "string",
            "title": "Antal sittplatser inomhus"
          },
          "antalSittplatserPaEventuellUteserver": {
            "type": "string",
            "title": "Antal sittplatser på eventuell uteservering"
          }
        },
        "title": "Sittplatser i lokalen"
      },
      "maximaltAntalPersonerILokalen": {
        "type": "object",
        "properties": {
          "antalPersoner": {
            "type": "string",
            "title": "Antal personer"
          }
        },
        "title": "Maximalt antal personer som kommer att vistas i lokalen samtidigt (inklusive personal)"
      },
      "harDuKassaregister": {
        "type": "string",
        "oneOf": [
          {
            "const": "JA",
            "title": "Ja"
          },
          {
            "const": "NEJ",
            "title": "Nej"
          }
        ],
        "title": "Har du kassaregister?"
      },
      "angeRegistreringskod": {
        "type": "object",
        "properties": {
          "registreringskod": {
            "type": "string",
            "title": "Registreringskod"
          }
        },
        "title": "Ange registreringskod"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "foretagsform": {
              "enum": [
                "AKTIEBOLAG",
                "ENSKILD_FIRMA_REGISTRERAD_HOS_SKATTEVERKET",
                "ENSKILD_FIRMA_REGISTRERAD_ENDAST_HOS",
                "FORENING_STIFTELSE",
                "HANDELSBOLAG",
                "KOMMANDITBOLAG"
              ]
            }
          },
          "required": [
            "foretagsform"
          ]
        },
        "then": {
          "required": [
            "verksamhetsbeskrivningsval"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "fakturaadressSammaSomForetaget": {
              "const": "NEJ"
            }
          },
          "required": [
            "fakturaadressSammaSomForetaget"
          ]
        },
        "then": {
          "properties": {
            "fakturamottagare": true
          }
        }
      },
      {
        "if": {
          "properties": {
            "verksamhetsbeskrivningsval": {
              "const": "JAG_VILL_SKRIVA_VERKSAMHETSBESKRIVNINGEN_I"
            }
          },
          "required": [
            "verksamhetsbeskrivningsval"
          ]
        },
        "then": {
          "properties": {
            "verksamhetsbeskrivning": true
          }
        }
      },
      {
        "if": {
          "properties": {
            "beskrivUtbudetAvMat": {
              "const": "JAG_VILL_SKRIVA_IN_MENYN"
            }
          },
          "required": [
            "beskrivUtbudetAvMat"
          ]
        },
        "then": {
          "properties": {
            "meny": true
          }
        }
      },
      {
        "if": {
          "properties": {
            "besoksadressSammaSomForetaget": {
              "const": "NEJ"
            }
          },
          "required": [
            "besoksadressSammaSomForetaget"
          ]
        },
        "then": {
          "properties": {
            "serveringsstalletsBesoksadress": true
          }
        }
      },
      {
        "if": {
          "properties": {
            "kommerNiAttServeraMat": {
              "const": "JA"
            }
          },
          "required": [
            "kommerNiAttServeraMat"
          ]
        },
        "then": {
          "properties": {
            "beskrivUtbudetAvMat": true
          }
        }
      },
      {
        "if": {
          "properties": {
            "beskrivUtbudetAvMat": {
              "const": "JAG_VILL_SKRIVA_IN_MENYN"
            }
          },
          "required": [
            "beskrivUtbudetAvMat"
          ]
        },
        "then": {
          "properties": {
            "meny": true
          }
        }
      },
      {
        "if": {
          "properties": {
            "besoksadressSammaSomForetaget": {
              "const": "NEJ"
            }
          },
          "required": [
            "besoksadressSammaSomForetaget"
          ]
        },
        "then": {
          "properties": {
            "serveringsstalletsBesoksadress": true
          }
        }
      },
      {
        "if": {
          "properties": {
            "harDuKassaregister": {
              "const": "JA"
            }
          },
          "required": [
            "harDuKassaregister"
          ]
        },
        "then": {
          "properties": {
            "angeRegistreringskod": true
          }
        }
      }
    ],
    "x-attachments": [
      {
        "key": "laddaUppFullmakt",
        "label": "Fullmakt",
        "requiredWhen": {
          "properties": {
            "arDuFirmatecknare": {
              "const": "NEJ"
            }
          },
          "required": [
            "arDuFirmatecknare"
          ]
        }
      },
      {
        "key": "bifogaAktuelltRegistreringsbevisFran",
        "label": "Registreringsbevis från Bolagsverket",
        "description": "Har du inte något registreringsbevis tillgängligt så kan du hämta ett på verksamt.se.",
        "requiredWhen": {
          "properties": {
            "foretagsform": {
              "enum": [
                "AKTIEBOLAG",
                "ENSKILD_FIRMA_REGISTRERAD_HOS_SKATTEVERKET",
                "FORENING_STIFTELSE",
                "HANDELSBOLAG",
                "KOMMANDITBOLAG"
              ]
            }
          },
          "required": [
            "foretagsform"
          ]
        }
      },
      {
        "key": "bifogaUppgifterOmAgarforhallanden",
        "label": "Uppgifter om ägarförhållanden",
        "description": "Handlingar som styrker vilka fysiska personer som finns bakom organisationsnumret. Aktiebolag: dokumentation som visar aktiefördelningen, exempelvis en aktiebok. Handelsbolag och kommanditbolag: dokumentation som visar ägarfördelningen, exempelvis ett bolagsavtal. Förening eller stiftelse: stadgar eller protokoll från konstituerande möte som visar vilka som är firmatecknare. Koncern: information om ägarförhållanden för koncernbolaget utöver handlingen för bolagsformen.",
        "requiredWhen": {
          "properties": {
            "foretagsform": {
              "enum": [
                "AKTIEBOLAG",
                "FORENING_STIFTELSE",
                "HANDELSBOLAG",
                "KOMMANDITBOLAG"
              ]
            }
          },
          "required": [
            "foretagsform"
          ]
        }
      },
      {
        "key": "bifogaRegisterutdragFranSkatteverket",
        "label": "Registerutdrag från Skatteverket",
        "description": "Av registerutdraget framgår om du eller ditt företag är godkänt för F-skatt eller FA-skatt, är momsregistrerat och registrerat som arbetsgivare. Du hämtar ett registerutdrag på verksamt.se.",
        "requiredWhen": {
          "properties": {
            "foretagsform": {
              "enum": [
                "AKTIEBOLAG",
                "ENSKILD_FIRMA_REGISTRERAD_HOS_SKATTEVERKET",
                "ENSKILD_FIRMA_REGISTRERAD_ENDAST_HOS",
                "FORENING_STIFTELSE",
                "HANDELSBOLAG",
                "KOMMANDITBOLAG"
              ]
            }
          },
          "required": [
            "foretagsform"
          ]
        }
      },
      {
        "key": "bifogaVerksamhetsbeskrivning",
        "label": "Verksamhetsbeskrivning"
      },
      {
        "key": "bifogaMeny",
        "label": "Meny"
      },
      {
        "key": "bifogatEgenkontrollprogramFolkol",
        "label": "Egenkontrollprogram för servering av folköl (klass 2)"
      }
    ]
  },
  "description": "Servering av folköl (klass 2)"
}
