{
  "name": "aot_tobacco_tobacco_free_nicotine_sales_notification",
  "version": "0.1",
  "value": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Anmälan om försäljning av tobaksfria nikotinprodukter",
    "type": "object",
    "properties": {
      "arDuFirmatecknare": {
        "type": "string",
        "oneOf": [
          {
            "const": "JA",
            "title": "Ja"
          },
          {
            "const": "NEJ",
            "title": "Nej"
          }
        ],
        "title": "Är du firmatecknare?"
      },
      "fakturaadressSammaSomForetaget": {
        "type": "string",
        "oneOf": [
          {
            "const": "JA",
            "title": "Ja"
          },
          {
            "const": "NEJ",
            "title": "Nej"
          }
        ],
        "title": "Är fakturaadressen samma som företagets adress?",
        "description": "Kommunen kan komma att ta ut en avgift. Om du vill att fakturan ska gå till den adress som företaget är registrerad på anger du \"Ja\" i fältet nedan. Om du vill att fakturan ska gå till en annan adress anger du \"Nej\" och fyller sedan i den. Du har även möjlighet att ange en fakturareferens."
      },
      "fakturamottagare": {
        "type": "object",
        "properties": {
          "cO": {
            "type": "string",
            "title": "c/o"
          },
          "utdelningsadress": {
            "type": "string",
            "title": "Utdelningsadress"
          },
          "postnummer": {
            "type": "string",
            "title": "Postnummer",
            "pattern": "^\\d{3}\\s?\\d{2}$"
          },
          "postort": {
            "type": "string",
            "title": "Postort"
          }
        },
        "required": [
          "utdelningsadress",
          "postnummer",
          "postort"
        ],
        "title": "Fakturamottagare"
      },
      "fakturareferens": {
        "type": "string",
        "title": "Fakturareferens",
        "description": "Ange här om du vill att fakturan ska ha någon specifik märkning, exempelvis ett namn eller nummer."
      },
      "verksamhetsbeskrivningsval": {
        "type": "string",
        "oneOf": [
          {
            "const": "JAG_VILL_SKRIVA_VERKSAMHETSBESKRIVNINGEN_I",
            "title": "Jag vill skriva verksamhetsbeskrivningen i formuläret"
          },
          {
            "const": "JAG_VILL_BIFOGA_VERKSAMHETSBESKRIVNINGEN_SOM",
            "title": "Jag vill bifoga verksamhetsbeskrivningen som fil"
          }
        ],
        "title": "Verksamhetsbeskrivning",
        "description": "Du måste lämna en detaljerad beskrivning av företagets verksamhet.\n\nHur vill du lämna verksamhetsbeskrivningen?"
      },
      "verksamhetsbeskrivning": {
        "type": "string",
        "title": "Verksamhetsbeskrivning"
      },
      "tidsperiodForForsaljningen": {
        "type": "string",
        "oneOf": [
          {
            "const": "TILLSVIDARE",
            "title": "Tillsvidare"
          },
          {
            "const": "TIDSBEGRANSAD_FORSALJNING",
            "title": "Tidsbegränsad försäljning"
          }
        ],
        "title": "Tidsperiod för försäljningen"
      },
      "startdatumForsaljning": {
        "type": "string",
        "format": "date",
        "title": "Startdatum försäljning"
      },
      "periodTidsbegransadForsaljning": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date",
            "title": "Från och med"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "title": "Till och med"
          }
        },
        "required": [
          "startDate",
          "endDate"
        ],
        "title": "Period för tidsbegränsad försäljning"
      },
      "forsaljningsstallet": {
        "type": "object",
        "properties": {
          "forsaljningsstalletsNamn": {
            "type": "string",
            "title": "Försäljningsställets namn"
          }
        },
        "required": [
          "forsaljningsstalletsNamn"
        ],
        "title": "Försäljningsstället",
        "description": ".cke{visibility:hidden;}"
      },
      "besoksadressSammaSomArendeagare": {
        "type": "string",
        "oneOf": [
          {
            "const": "JA",
            "title": "Ja"
          },
          {
            "const": "NEJ",
            "title": "Nej"
          }
        ],
        "title": "Är försäljningsställets besöksadress samma som ärendeägarens adress?"
      },
      "besoksadress": {
        "type": "object",
        "properties": {
          "gatuadress": {
            "type": "string",
            "title": "Gatuadress"
          },
          "postnummer": {
            "type": "string",
            "title": "Postnummer"
          },
          "postort": {
            "type": "string",
            "title": "Postort"
          },
          "telefonnummer": {
            "type": "string",
            "title": "Telefonnummer"
          },
          "ePost": {
            "type": "string",
            "title": "E-post",
            "format": "email"
          }
        },
        "required": [
          "gatuadress",
          "postnummer",
          "postort",
          "telefonnummer"
        ],
        "title": "Besöksadress"
      },
      "bedriverAvenDistansforsaljning": {
        "type": "string",
        "oneOf": [
          {
            "const": "JA",
            "title": "Ja"
          },
          {
            "const": "NEJ",
            "title": "Nej"
          }
        ],
        "title": "Jag kommer också bedriva distansförsäljning",
        "description": "Distansförsäljning är försäljning av varor via postorder, telefon eller internet där leverantören ansvarar för leveransen av varorna."
      },
      "hemsida": {
        "type": "object",
        "properties": {
          "hemsida": {
            "type": "string",
            "title": "Hemsida"
          }
        },
        "required": [
          "hemsida"
        ],
        "title": "Hemsida"
      },
      "avtalMedTillverkareEllerPartihandlare": {
        "type": "string",
        "oneOf": [
          {
            "const": "JA",
            "title": "Ja"
          },
          {
            "const": "NEJ",
            "title": "Nej"
          }
        ],
        "title": "Finns avtal med tillverkare, partihandlare eller importör"
      }
    },
    "required": [
      "arDuFirmatecknare",
      "verksamhetsbeskrivningsval",
      "fakturaadressSammaSomForetaget",
      "besoksadressSammaSomArendeagare",
      "tidsperiodForForsaljningen",
      "forsaljningsstallet",
      "bedriverAvenDistansforsaljning",
      "avtalMedTillverkareEllerPartihandlare"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "fakturaadressSammaSomForetaget": {
              "const": "NEJ"
            }
          },
          "required": [
            "fakturaadressSammaSomForetaget"
          ]
        },
        "then": {
          "properties": {
            "fakturamottagare": true
          }
        }
      },
      {
        "if": {
          "properties": {
            "verksamhetsbeskrivningsval": {
              "const": "JAG_VILL_SKRIVA_VERKSAMHETSBESKRIVNINGEN_I"
            }
          },
          "required": [
            "verksamhetsbeskrivningsval"
          ]
        },
        "then": {
          "properties": {
            "verksamhetsbeskrivning": true
          }
        }
      },
      {
        "if": {
          "properties": {
            "tidsperiodForForsaljningen": {
              "const": "TIDSBEGRANSAD_FORSALJNING"
            }
          },
          "required": [
            "tidsperiodForForsaljningen"
          ]
        },
        "then": {
          "required": [
            "periodTidsbegransadForsaljning"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "tidsperiodForForsaljningen": {
              "const": "TILLSVIDARE"
            }
          },
          "required": [
            "tidsperiodForForsaljningen"
          ]
        },
        "then": {
          "required": [
            "startdatumForsaljning"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "besoksadressSammaSomArendeagare": {
              "const": "NEJ"
            }
          },
          "required": [
            "besoksadressSammaSomArendeagare"
          ]
        },
        "then": {
          "required": [
            "besoksadress"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "bedriverAvenDistansforsaljning": {
              "const": "JA"
            }
          },
          "required": [
            "bedriverAvenDistansforsaljning"
          ]
        },
        "then": {
          "properties": {
            "hemsida": true
          }
        }
      }
    ],
    "x-attachments": [
      {
        "key": "POWER_OF_ATTORNEY",
        "label": "Fullmakt",
        "requiredWhen": {
          "properties": {
            "arDuFirmatecknare": {
              "const": "NEJ"
            }
          },
          "required": [
            "arDuFirmatecknare"
          ]
        }
      },
      {
        "key": "CERTIFICATE_OF_REGISTRATION",
        "label": "Registreringsbevis från Bolagsverket",
        "description": "Har du inte något registreringsbevis tillgängligt så kan du hämta ett på verksamt.se."
      },
      {
        "key": "OWNERSHIP_INFORMATION",
        "label": "Uppgifter om ägarförhållanden",
        "description": "Handlingar som styrker vilka fysiska personer som finns bakom organisationsnumret. Aktiebolag: dokumentation som visar aktiefördelningen, exempelvis en aktiebok. Handelsbolag och kommanditbolag: dokumentation som visar ägarfördelningen, exempelvis ett bolagsavtal. Förening eller stiftelse: stadgar eller protokoll från konstituerande möte som visar vilka som är firmatecknare. Koncern: information om ägarförhållanden för koncernbolaget utöver handlingen för bolagsformen."
      },
      {
        "key": "TAX_AGENCY_EXTRACT",
        "label": "Registerutdrag från Skatteverket",
        "description": "Av registerutdraget framgår om du eller ditt företag är godkänt för F-skatt eller FA-skatt, är momsregistrerat och registrerat som arbetsgivare. Du hämtar ett registerutdrag på verksamt.se."
      },
      {
        "key": "BUSINESS_DESCRIPTION",
        "label": "Verksamhetsbeskrivning"
      },
      {
        "key": "COUNTY_BOARD_REGISTRATION",
        "label": "Registrering från Länsstyrelsen"
      },
      {
        "key": "SUPPLIER_AGREEMENT",
        "label": "Avtal med tillverkare eller partihandlare",
        "requiredWhen": {
          "properties": {
            "avtalMedTillverkareEllerPartihandlare": {
              "const": "JA"
            }
          },
          "required": [
            "avtalMedTillverkareEllerPartihandlare"
          ]
        }
      },
      {
        "key": "PRODUCT_LIST",
        "label": "Produktlista",
        "description": "Produkterna som ska säljas är registrerade hos Folkhälsomyndigheten."
      },
      {
        "key": "RIGHT_OF_DISPOSAL",
        "label": "Underlag som styrker dispositionsrätten",
        "description": "Underlag som visar att företaget har rätt att nyttja lokalen."
      },
      {
        "key": "SELF_MONITORING_PROGRAM",
        "label": "Egenkontrollprogram",
        "description": "Lagen om tobak och liknande produkter och lagen om tobaksfria nikotinprodukter kräver att ett egenkontrollprogram bifogas anmälan. Folkhälsomyndigheten har en vägledning för näringsidkare."
      }
    ]
  },
  "description": "Anmälan om försäljning av tobaksfria nikotinprodukter"
}
